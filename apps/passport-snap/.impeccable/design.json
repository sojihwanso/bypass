  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "그 화면의 '지금 할 일' 하나. 눌림 받침이 있다.",
      "html": "<button class=\"ds-btn-primary\">오늘 학습 바로 시작 →</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#4a8051;color:#fff;font-weight:700;font-size:16px;padding:12px 22px;border:none;border-radius:12px;box-shadow:0 3px 0 #2f5a35;cursor:pointer;transition:transform .08s ease,box-shadow .08s ease,background .15s ease}.ds-btn-primary:hover{background:#42744a}.ds-btn-primary:active{transform:translateY(2px);box-shadow:0 1px 0 #2f5a35}.ds-btn-primary:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "보조 동작.",
      "html": "<button class=\"ds-btn-outline\">제원 전체 보기</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;background:#fff;color:#2d3436;border:1.5px solid #e6e2da;border-radius:12px;padding:10px 16px;font-weight:700;font-size:14px;cursor:pointer;transition:background .15s ease}.ds-btn-outline:hover{background:#f2f0eb;border-color:#d4cfc4}.ds-btn-outline:active{transform:translateY(2px)}.ds-btn-outline:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Soft Sky Button",
      "kind": "button",
      "refersTo": "button-soft-sky",
      "description": "퀴즈 같은 보조 학습 동작.",
      "html": "<button class=\"ds-btn-sky\">랜덤 10문장 퀴즈</button>",
      "css": ".ds-btn-sky{background:#ebf5fb;color:#36698a;border:1.5px solid #c5e2f3;border-radius:12px;padding:10px 16px;font-weight:700;font-size:14px;cursor:pointer}.ds-btn-sky:hover{background:#dceefa;border-color:#74b3d8}.ds-btn-sky:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "진도·데이터를 버리는 확인에만.",
      "html": "<button class=\"ds-btn-danger\">초기화</button>",
      "css": ".ds-btn-danger{background:#b04f4f;color:#fff;border:none;border-radius:12px;padding:10px 16px;font-weight:700;font-size:14px;box-shadow:0 3px 0 #853535;cursor:pointer}.ds-btn-danger:hover{background:#a14646}.ds-btn-danger:active{transform:translateY(2px);box-shadow:0 1px 0 #853535}.ds-btn-danger:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "치트시트 문장 검색.",
      "html": "<input class=\"ds-input\" placeholder=\"문장·뜻·발음 검색\" />",
      "css": ".ds-input{min-width:210px;padding:10px 15px;border-radius:13px;border:1.5px solid #e6e2da;background:#fff;color:#2d3436;font-size:16px;outline:none}.ds-input:focus{border-color:#74b3d8;box-shadow:0 0 0 3px #ebf5fb}"
    },
    {
      "name": "Category Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "카테고리 필터. 선택은 하늘색.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip is-active\">전체</button><button class=\"ds-chip\">식당·주문</button><button class=\"ds-chip\">공항·교통</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chip{padding:7px 13px;border-radius:999px;background:#fff;border:1.5px solid #e6e2da;font-size:12.5px;font-weight:700;color:#2d3436;cursor:pointer}.ds-chip:hover{border-color:#d4cfc4}.ds-chip.is-active{background:#ebf5fb;color:#36698a;border-color:#74b3d8}.ds-chip:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Top Navigation",
      "kind": "nav",
      "refersTo": "nav-tab-active",
      "description": "상단 바의 텍스트 탭.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-mark\">여</span><b>여권스냅</b><a class=\"ds-tab is-active\">학습 코스</a><a class=\"ds-tab\">문자 익히기</a><a class=\"ds-tab\">치트시트</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:8px;padding:10px 16px;background:rgba(248,247,244,.95);border-bottom:1.5px solid #e6e2da;font-size:14px}.ds-mark{width:30px;height:30px;border-radius:9px;background:#e6f4e8;border:1.5px solid #b8dec0;color:#3e7046;font-weight:800;display:inline-flex;align-items:center;justify-content:center}.ds-nav b{margin-right:12px;font-size:17.5px}.ds-tab{padding:8px 14px;border-radius:11px;font-weight:700;color:#2d3436;cursor:pointer}.ds-tab:hover{color:#2d3436;background:#f2f0eb}.ds-tab.is-active{background:#ebf5fb;color:#36698a}"
    },
    {
      "name": "Phrase Item",
      "kind": "card",
      "refersTo": "phrase-item",
      "description": "치트시트 문장 한 줄. 원문→가나→발음→뜻→팁.",
      "html": "<div class=\"ds-phrase\"><div><div class=\"ds-jp\" lang=\"ja\">おはようございます。</div><div class=\"ds-ko\">오하요 고자이마스</div><div class=\"ds-mean\">안녕하세요. (아침 인사)</div><span class=\"ds-tip\">오전 10시 전후까지 쓰는 인사예요.</span></div><button class=\"ds-ico\" aria-label=\"듣기\">▶</button></div>",
      "css": ".ds-phrase{display:flex;justify-content:space-between;gap:14px;background:#fff;border:1.5px solid #e6e2da;border-radius:15px;padding:15px 16px}.ds-jp{font-size:21px;font-weight:800;line-height:1.35}.ds-ko{font-size:14px;font-weight:700;color:#36698a;margin-top:2px}.ds-mean{font-size:16px;font-weight:700;margin-top:4px}.ds-tip{display:block;margin-top:6px;font-size:14px;background:#f2f0eb;padding:7px 11px;border-radius:9px}.ds-ico{width:34px;height:34px;border-radius:10px;background:#f2f0eb;border:1.5px solid #e6e2da;cursor:pointer}.ds-ico:hover{background:#e6e2da}.ds-ico:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    },
    {
      "name": "Segmented Toggle",
      "kind": "custom",
      "description": "코스·타이머·목소리 선택.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-opt is-active\">7일 코스</button><button class=\"ds-seg-opt\">14일 코스</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:3px;padding:3px;background:#f2f0eb;border:1.5px solid #e6e2da;border-radius:10px}.ds-seg-opt{padding:6px 12px;border-radius:8px;font-size:12.5px;font-weight:700;color:#2d3436;background:none;border:none;cursor:pointer}.ds-seg-opt.is-active{background:#fff;box-shadow:0 1px 3px rgba(45,52,54,.08)}.ds-seg-opt:focus-visible{outline:2px solid #36698a;outline-offset:2px}"
    }
  ],
